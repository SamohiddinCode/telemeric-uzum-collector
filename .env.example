TELEGRAM_COLLECTOR_SECRET=
SITES_AUTH_TOKEN=
SETUP_TOKEN=
HISTORY_LIMIT=5000

# Daily SLA analytics. Disabled by default so the existing collector behavior stays unchanged.
DAILY_REPORT_ENABLED=false
REPORT_CHAT_ID=8419189523
REPORT_TIMEZONE=Asia/Tashkent
WORKDAY_START=10:00
WORKDAY_END=19:00
REPORT_TIME=19:05
SLA_TARGET_MINUTES=15
SLA_TARGET_PERCENT=90
TICKET_GAP_MINUTES=30
# All support replies come from one shared Telegram account.
ANALYTICS_AGENT_IDS=
ANALYTICS_AGENT_USERNAMES=uzum_franchise
# Shift opening/closing messages define actual report boundaries when present.
SERVICE_BOT_USERNAMES=opening_closing_bot
REPORT_MENTIONS=@Ddmit05
ANALYTICS_DB_PATH=/tmp/telemeric/analytics.sqlite3

# Optional Google Sheets archive. Both values are required to enable it.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# FAQ assistant private-preview mode. It never replies in the source group.
FAQ_SHADOW_ENABLED=false
FAQ_SHADOW_RECIPIENT_ID=8419189523
FAQ_SHADOW_MIN_CONFIDENCE=0.58
FAQ_SHADOW_MAX_AGE_SECONDS=600
FAQ_KNOWLEDGE_BASE_PATH=faq_knowledge_base.json
